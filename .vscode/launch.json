{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fortune frozen",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/notdec",
      "args": [
        "--frozen-tr-input-ir",
        "${workspaceFolder}/test/type-recovery/realworld/cases/fortune.o3.wasm.ll",
        "-o",
        "/tmp/fortune.c",
        "--tr-level=2",
        "-g",
        "--work-dir=${workspaceFolder}/work_dir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Clean and Build",
      "environment": [
        {
          "name": "NOTDEC_EXTRA_CONSTRAINTS",
          "value": "test/type-recovery/realworld/support/fortune.o3.wasm.extra.json"
        },
        {
          "name": "NOTDEC_TYPEBUILDER_TRACE_CONVERTSTRUCT",
          "value": "1"
        },
        {
          "name": "NOTDEC_BINARYSUB_TRACE",
          "value": "1"
        }
      ],
    },
    {
      "name": "06_SimpleRecursive2",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/notdec",
      "args": [
        "--frozen-tr-input-ir",
        "${workspaceFolder}/test/type-recovery/llvm-ir/cases/06_SimpleRecursive2.ll",
        "-o",
        "/tmp/06_SimpleRecursive2.c",
        "--tr-level=2",
        "-g",
        "--work-dir=${workspaceFolder}/work_dir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Clean and Build",
      "environment": [
        {
          "name": "NOTDEC_TYPEBUILDER_TRACE_CONVERTSTRUCT",
          "value": "1"
        },
        {
          "name": "NOTDEC_BINARYSUB_TRACE",
          "value": "1"
        }
      ],
    },
    {
      "name": "binarysub",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "preLaunchTask": "build binarysub",
      "program": "${workspaceFolder}/external/binarysub/build/binarysub",
      "args": [],
      "cwd": "${workspaceFolder}/external/binarysub"
    },
    {
      "name": "dec",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/notdec",
      "args": [
        "${file}",
        "-o",
        "/tmp/${fileBasename}.c",
        "--tr-level=2",
        "-g",
        "--work-dir=${workspaceFolder}/work_dir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Clean and Build",
      "environment": [
        {
          "name": "NOTDEC_POLY_FUNCS",
          "value": "/sn640/NotDec-Exp/ICSE-HOWARD/polymorphic_funcs.json"
        },
        {
          "name": "NOTDEC_TYPEBUILDER_TRACE_CONVERTSTRUCT",
          "value": "1"
        },
        {
          "name": "NOTDEC_BINARYSUB_TRACE",
          "value": "1"
        }
      ],
    },
    {
      "name": "dec emit pre-TR IR",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/notdec",
      "args": [
        "${file}",
        "--emit-tr-input-ir=${workspaceFolder}/work_dir/02-mlsub-input.ll",
        "--tr-level=2",
        "-g",
        "--work-dir=${workspaceFolder}/work_dir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Clean and Build",
      "environment": [
        {
          "name": "NOTDEC_POLY_FUNCS",
          "value": "/sn640/NotDec-Exp/ICSE-HOWARD/polymorphic_funcs.json"
        },
        {
          "name": "NOTDEC_TYPEBUILDER_TRACE_CONVERTSTRUCT",
          "value": "1"
        }
      ],
      // "setupCommands": [{"text": "set auto-solib-add off"}]
    },
    {
      "name": "dec frozen TR only",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/notdec",
      "args": [
        "${file}",
        "-o",
        "${workspaceFolder}/work_dir/04-stage-b.out.ll",
        "--tr-level=2",
        "--frozen-tr-input-ir",
        "-g",
        "--work-dir=${workspaceFolder}/work_dir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Clean and Build",
      "environment": [
        {
          "name": "NOTDEC_POLY_FUNCS",
          "value": "/sn640/NotDec-Exp/ICSE-HOWARD/polymorphic_funcs.json"
        },
        {
          "name": "NOTDEC_TYPEBUILDER_TRACE_CONVERTSTRUCT",
          "value": "1"
        }
      ],
      // "setupCommands": [{"text": "set auto-solib-add off"}]
    },
    {
      "name": "Python compare fortune wasm DWARF",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test/tools/compare_htypes_with_wasm_dwarf.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "--htypes",
        "${workspaceFolder}/build/test/artifacts/notdec.type_recovery.realworld.tr_level_2/fortune.o3.wasm.out.htypes",
        "--truth",
        "${workspaceFolder}/build/test/artifacts/notdec.type_recovery.realworld.tr_level_2/fortune.o3.wasm.truth.json",
        "--config",
        "${workspaceFolder}/build/test/artifacts/notdec.type_recovery.realworld.tr_level_2/fortune.o3.wasm.compare.config.json",
        "--report-json",
        "${workspaceFolder}/build/test/artifacts/notdec.type_recovery.realworld.tr_level_2/fortune.o3.wasm.compare.json",
        "--report-text",
        "${workspaceFolder}/build/test/artifacts/notdec.type_recovery.realworld.tr_level_2/fortune.o3.wasm.compare.txt",
        "--report-markdown",
        "${workspaceFolder}/build/test/artifacts/notdec.type_recovery.realworld.tr_level_2/fortune.o3.wasm.compare.md"
      ]
    }
  ]
}
