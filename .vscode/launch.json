{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "binarysub",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "preLaunchTask": "build binarysub",
      "program": "${workspaceFolder}/external/binarysub/build/binarysub",
      "args": [],
      "cwd": "${workspaceFolder}/external/binarysub"
    },
    {
      "name": "dec",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/notdec",
      "args": [
        "${file}",
        "-o",
        "/tmp/${fileBasename}.c",
        "--tr-level=2",
        "-g",
        "--work-dir=${workspaceFolder}/work_dir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Clean and Build",
      "environment": [
        {
          "name": "NOTDEC_SUMMARY_OVERRIDE",
          "value": "/sn640/NotDec-Exp/ICSE-HOWARD/summarys.json"
        },
        {
          "name": "NOTDEC_SIGNATURE_OVERRIDE",
          "value": "/sn640/NotDec-Exp/ICSE-HOWARD/signatures.json"
        },
        {
          "name": "NOTDEC_POLY_FUNCS",
          "value": "/sn640/NotDec-Exp/ICSE-HOWARD/polymorphic_funcs.json"
        },
        {
          "name": "NOTDEC_TYPEBUILDER_TRACE_CONVERTSTRUCT",
          "value": "1"
        }
      ],
      // "setupCommands": [{"text": "set auto-solib-add off"}]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "GraphTest",
      "program": "${workspaceFolder}/build/bin/GraphTest",
      "args": [
        "--gtest_filter=Retypd.SaturationPaperTest",
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: build",
      "env": {
        // "NOTDEC_SAT_DENSESUBTYPE": "1",
        "DEBUG_TRANS_SAT_GRAPH": "1",
        "DEBUG_TRANS_PUSH_SPLIT_GRAPH": "1",
        "DEBUG_TRANS_CV_SPLIT_GRAPH": "1",
        "DEBUG_TRANS_MIN_GRAPH": "1",
        "DEBUG_TRANS_LAYER_SPLIT_GRAPH": "1",
      }
    },
    {
      "name": "Python Access2Struct",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test/Access2Struct/main.py",
      "console": "integratedTerminal",
      "args": "TestAccess.test_7_Negative"
    }
  ]
}
