# HTypeResult

[decls]

[types]
[+] <null-value> => lower=<null> ; upper=top:32
[+] @isFloat => lower=(void (*)(f32))* ; upper=(void (*)(f32))*
[+] @main => lower=(bottom:32 (*)(top:32, top:32))* ; upper=top:32
[+] @ptrFloat => lower=(void (*)(ptr<load=f32, store=void, psize=32>))* ; upper=(void (*)(bottom:32))*
[+] const(i32 0)@main::%bb.allocator.i3:0 => lower=bottom:32 ; upper=top:32
[+] isFloat::arg0 => lower=f32 ; upper=f32
[+] main::%stack => lower=bottom:32 ; upper=ptr<load=f32, store=void, psize=32>
[-] main::%stackPtr => lower=bottom:32 ; upper=ptr<load=f32, store=void, psize=32>
[+] main::<ret> => lower=bottom:32 ; upper=top:32
[+] main::arg0 => lower=bottom:32 ; upper=top:32
[+] main::arg1 => lower=bottom:32 ; upper=top:32
[+] ptrFloat::%f1 => lower=f32 ; upper=f32
[+] ptrFloat::%v_12 => lower=bottom:32 ; upper=ptr<load=f32, store=void, psize=32>
[+] ptrFloat::arg0 => lower=bottom:32 ; upper=ptr<load=f32, store=void, psize=32>

[memory]
type => top:32
