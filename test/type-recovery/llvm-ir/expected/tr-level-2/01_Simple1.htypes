# HTypeResult

[decls]

[types]
[+] <null-value> => lower=<null> ; upper=top:32
[+] @main => lower=(bottom:32 (*)(top:32, top:32))* ; upper=top:32
[+] const(i32 0)@main::%bb.allocator.i0:0 => lower=bottom:32 ; upper=top:32
[+] main::<ret> => lower=bottom:32 ; upper=top:32
[+] main::arg0 => lower=bottom:32 ; upper=top:32
[+] main::arg1 => lower=bottom:32 ; upper=top:32

[memory]
type => top:32
