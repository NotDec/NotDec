# HTypeResult

[decls]

[types]
[+] <null-value> => lower=<null> ; upper=top:32
[+] @isFloat => lower=(void (*)(f32))* ; upper=(void (*)(f32))*
[+] @main => lower=top:32 ; upper=(bottom:32 (*)(top:32, top:32))*
[+] @ptrFloat => lower=(void (*)(bottom:32))* ; upper=(void (*)('d:32 & ptr<load=void, store='d:32, psize=32>))*
[+] const(i32 0)@main::%bb.allocator.i3:0 => lower=top:32 ; upper=bottom:32
[+] isFloat::arg0 => lower=f32 ; upper=f32
[+] main::%stack => lower='d:32 & ptr<load=void, store='d:32, psize=32> ; upper=bottom:32
[-] main::%stackPtr => lower='d:32 & ptr<load=void, store='d:32, psize=32> ; upper=bottom:32
[+] main::<ret> => lower=top:32 ; upper=bottom:32
[+] main::arg0 => lower=top:32 ; upper=bottom:32
[+] main::arg1 => lower=top:32 ; upper=bottom:32
[+] ptrFloat::%f1 => lower=f32 ; upper=f32
[+] ptrFloat::%v1 => lower=void* ; upper=bottom:32
[+] ptrFloat::%v2 => lower=ptr<load=f32, store=void, psize=32> ; upper=bottom:32
[+] ptrFloat::%v3 => lower='d:32 & ptr<load=void, store='d:32, psize=32> ; upper=bottom:32
[+] ptrFloat::arg0 => lower='d:32 & ptr<load=void, store='d:32, psize=32> ; upper=bottom:32

[memory]
type => top:32

