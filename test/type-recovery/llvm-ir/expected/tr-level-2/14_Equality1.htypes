[+] main::%cond => i1
[+] main::%eq0 => bottom:32
[+] main::%eq1 => bottom:32
[+] main::%stack => bottom:32
[-] main::%stackPtr => ('d:32 & ptr<load=f32, store=void, psize=32>)
