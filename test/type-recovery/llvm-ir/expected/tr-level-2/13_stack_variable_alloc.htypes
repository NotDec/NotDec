# HTypeResult

[decls]

[types]
[+] <null-value> => lower=<null> ; upper=top:32
[+] @.str => lower=bottom:32 ; upper=top:32
[+] @main => lower=(bottom:32 (*)())* ; upper=top:32
[+] @printf => lower=(bottom:32 (*)(top:32))* ; upper=(top:32 (*)(bottom:32, bottom:32, bottom:32, bottom:32))*
[+] const(i32 0)@main::%bb0.i4:0 => lower=bottom:32 ; upper=top:32
[-] main::%bb0.i0 => lower=bottom:32 ; upper=top:32
[-] main::%bb0.i1 => lower=bottom:32 ; upper=top:32
[-] main::%bb0.i2 => lower=bottom:32 ; upper=top:32
[+] main::%bb0.i3 => lower=bottom:32 ; upper=top:32
[+] main::<ret> => lower=bottom:32 ; upper=top:32
[+] printf::<ret> => lower=bottom:32 ; upper=top:32
[+] printf::arg0 => lower=bottom:32 ; upper=top:32

[memory]
type => top:32
