# HTypeResult

[decls]

[upper]
<null-value> => i32
@fun_1 => ('i:32 | ('c:32 | 'd:32)) (*)((('c:32 & 'd:32) & ptr<load=void, store=('c:32 | 'i:32), psize=32>))*
@main => ('i:32 | ('c:32 | 'd:32)) (*)('f:32, 'g:32)*
fun_1::%addr => ('c:32 | 'i:32)
fun_1::<ret> => ('i:32 | ('c:32 | 'd:32))
fun_1::arg0 => ('c:32 | 'i:32)
main::%a => ('i:32 | ('c:32 | 'd:32))
main::%stack => (('i:32 | ('c:32 | 'd:32)) | ptr<load=void, store=('c:32 & 'i:32), psize=32>)
main::%stacki => 'i:32
main::<ret> => ('i:32 | ('c:32 | 'd:32))
main::arg0 => 'f:32
main::arg1 => 'g:32

[lower]

[memory]
type => i32

